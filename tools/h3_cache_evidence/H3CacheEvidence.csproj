<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="$(ReclaimerRoot)/Reclaimer.Blam/Reclaimer.Blam.csproj" />
  </ItemGroup>
  <Target Name="RequireReaderSource" BeforeTargets="PrepareForBuild" Condition="'$(ReclaimerRoot)' == ''">
    <Error Text="Supply ReclaimerRoot via Build-H3CacheEvidence.ps1; the reader revision is verified there." />
  </Target>
</Project>
